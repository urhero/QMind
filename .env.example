# .env.example — 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.
# cp .env.example .env
#
# 유니버스 전환: 아래 두 블록 중 하나만 활성(주석 해제)하면 된다. BENCHMARK 값 하나로
# config.py 가 파라미터/DB/출력 폴더(output/{BENCHMARK}/)/데이터 파일을 전부 결정한다.
# BENCHMARK 를 비워 두면 config.py 의 BENCHMARK 상수(기본 MXWO, 2026-09-09)가 쓰인다.
# 워크트리(QMind_mxwo / QMind_mxcn1a)마다 자기 .env 를 두고 BENCHMARK 를 고정한다.

# ── MXWO (MSCI World, 2015-06~) ──
BENCHMARK=MXWO
UNIVERSE=clarifi_mxwo_afl
SERVER_NAME=10.206.101.14
DB_NAME=kb_global

# ── MXCN1A (중국 A주, 2009-12~) ──
# BENCHMARK=MXCN1A
# UNIVERSE=clarifi_mxcn1a_afl
# SERVER_NAME=10.206.1.19,9433
# DB_NAME=GLOBAL

USER_NAME=sa
USER_PWD=your_password_here
ODBC_NAME=ODBC Driver 17 for SQL Server
